{
    "version": 8,
    "configurePresets": [
        {
            "name": "clang",
            "displayName": "Clang 19.1.0 x86_64-pc-windows-msvc",
            "description": "正在使用编译器: C = C:\\Program Files\\LLVM\\bin\\clang.exe, CXX = C:\\Program Files\\LLVM\\bin\\clang++.exe",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-cl",
            "displayName": "Clang-cl 19.1.0 x86_64-pc-windows-msvc",
            "description": "正在使用编译器: C = C:\\Program Files\\LLVM\\bin\\clang-cl.exe, CXX = C:\\Program Files\\LLVM\\bin\\clang-cl.exe",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "vs2026",
            "displayName": "vs2026",
            "description": "将编译器用于 Visual Studio 18 2026 (x64 体系结构),存在msb 1011错误时请使用ninja-msvc",
            "generator": "Visual Studio 18 2026",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "ASSIMP_BUILD_ASSIMP_VIEW": "OFF",
                "DYNAMIC_OPENSCENEGRAPH":"OFF",
                "DYNAMIC_OPENTHREADS":"OFF",
                "BUILD_OSG_PLUGINS_BY_DEFAULT": "OFF",
                "BUILD_OSG_APPLICATIONS": "OFF",
                "BUILD_OSG_EXAMPLES": "OFF",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_SUPPRESS_REGENERATION": "ON"
            }
        },
        {
            "name": "ninja-msvc",
            "displayName": "ninja-msvc",
            "description": "将编译器用于 Visual Studio 18 2026 (x64 体系结构)，使用 Ninja 生成器, 需要cmake tools 禁用kit自动扫描",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "ASSIMP_BUILD_ASSIMP_VIEW": "OFF",
                "ASSIMP_WARNINGS_AS_ERRORS": "OFF",
                "ASSIMP_BUILD_ASSIMP_TOOLS": "OFF",
                "ASSIMP_BUILD_TESTS": "OFF",
                "DYNAMIC_OPENSCENEGRAPH":"OFF",
                "DYNAMIC_OPENTHREADS":"OFF",
                "BUILD_OSG_PLUGINS_BY_DEFAULT": "OFF",
                "BUILD_OSG_APPLICATIONS": "OFF",
                "BUILD_OSG_EXAMPLES": "OFF",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vs2026",
            "displayName": "vs2026",
            "configurePreset": "vs2026",
            "jobs": 0
        },
        {
            "name": "ninja-msvc-debug",
            "displayName": "ninja-msvc-debug",
            "configurePreset": "ninja-msvc",
            "configuration": "Debug",
            "jobs": 0
        }
    ]
}
