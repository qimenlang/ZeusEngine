# 立方体 OBJ 文件
# 边长为1，中心位于原点

# 顶点坐标 (v)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# 纹理坐标 (vt)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# 法线坐标 (vn)
vn  0.0  0.0 -1.0  # 前向面
vn  0.0  0.0  1.0  # 后向面
vn  0.0 -1.0  0.0  # 底面
vn  0.0  1.0  0.0  # 顶面
vn -1.0  0.0  0.0  # 左面
vn  1.0  0.0  0.0  # 右面

# 面定义 (f vertex_index/uv_index/normal_index)

# 前面 (Z-)
f 1/1/1 2/2/1 3/3/1
f 3/3/1 4/4/1 1/1/1

# 后面 (Z+)
f 5/1/2 6/2/2 7/3/2
f 7/3/2 8/4/2 5/1/2

# 底面 (Y-)
f 1/1/3 5/2/3 6/3/3
f 6/3/3 2/4/3 1/1/3

# 顶面 (Y+)
f 4/1/4 3/2/4 7/3/4
f 7/3/4 8/4/4 4/1/4

# 左面 (X-)
f 1/1/5 4/2/5 8/3/5
f 8/3/5 5/4/5 1/1/5

# 右面 (X+)
f 2/1/6 6/2/6 7/3/6
f 7/3/6 3/4/6 2/1/6